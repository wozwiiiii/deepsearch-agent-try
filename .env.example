# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# API 安全配置
# CORS 允许的前端来源，逗号分隔；部署公网时必须改成真实前端域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 单个上传文件大小上限（MB）
MAX_UPLOAD_SIZE_MB=20
# 单次上传请求的总大小上限（MB）与文件数上限（防海量小文件绕过单文件限制）
MAX_UPLOAD_TOTAL_MB=100
# MAX_UPLOAD_FILES=20

# 认证与租户配置
# 格式 用户名:密钥，逗号分隔；用户名限小写字母/数字（最长15位），密钥至少16位
# 未配置 API_KEYS 时默认拒绝业务请求（fail-closed）；仅本地联调可设 ALLOW_DEV_MODE=1
# 生成密钥示例：openssl rand -hex 32
API_KEYS=
# ALLOW_DEV_MODE=1
# 短时链接令牌（P1-2）：WS 握手无法带请求头，先经 /api/token 换令牌再连接，
# 长期密钥不进 URL；令牌有效期（秒）与签发接口限流可配
LINK_TOKEN_TTL_SECONDS=60
RATE_LIMIT_TOKEN=30/minute
# LangGraph 会话检查点数据库路径（持久化会话状态，重启不丢）
CHECKPOINT_DB=

# 事件回放配置（P0-3）
# 监控事件持久化数据库路径：断线重连时按 last_seq 差量补发，服务重启后可回放
EVENT_DB=
# 每个会话（task_key）保留的最大事件条数，超出写入时裁剪（防库无限膨胀）
EVENT_MAX_PER_STREAM=1000
# 首次连接（不带 last_seq）时补发的最近事件条数（页面刷新恢复执行轨迹）
EVENT_REPLAY_LIMIT=100

# 限流与成本治理（按密钥哈希/IP 计数，limits 库语法）
RATE_LIMIT_TASK=10/minute
RATE_LIMIT_UPLOAD=30/minute
# 单次任务 / 单会话累计的模型调用次数硬上限（超限任务终止并告知前端）
MODEL_RUN_LIMIT=80
MODEL_THREAD_LIMIT=300
# 单次任务 token 预算（按 usage_metadata 累计，超预算任务立即终止并告知前端）
MODEL_TOKEN_RUN_LIMIT=1500000
# 任务级硬超时（秒）：LLM 网络半开挂起时任务会被超时终止并告知前端，而非永远运行中
TASK_TIMEOUT_SECONDS=600

# 任务队列模式（P0-2 阶段 1）
# 空 / inline = 进程内直跑（默认，行为与单机版完全一致）
# redis = 任务入 ARQ 队列由独立 worker 进程执行（先 docker compose up -d postgres redis，
#         再运行 arq app.queue.worker.WorkerSettings，见 docs/PRODUCTION_NOTES.md）
TASK_QUEUE_MODE=
REDIS_URL=redis://localhost:6379/0
# 任务表与 AsyncPostgresSaver checkpointer 共用的 Postgres（compose 映射到 5433）
POSTGRES_DSN=postgresql://deepsearch:deepsearch@localhost:5433/deepsearch_tasks
# worker 取消轮询间隔（秒）：取消请求经任务表生效，worker 按此间隔检查后中止执行
CANCEL_POLL_SECONDS=2
# 单个 worker 进程并发执行的任务数上限
WORKER_MAX_JOBS=2
EVENT_POLL_SECONDS=1       # WS 事件轮询桥间隔（秒）；留空/未设置默认 1
